{
  "name": "@heliony/ui",
  "version": "0.1.0",
  "description": "Design system Heliony : tokens Dark et Light, composants Svelte 5 sur Bits UI, styles Tailwind v4, référence pour les assistants et outils.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles/heliony.css",
    "./theme.css": "./dist/styles/theme.css",
    "./tokens.css": "./dist/styles/tokens.css",
    "./tokens.json": "./tokens/tokens.json",
    "./fonts/*": "./dist/fonts/*",
    "./ai/*": "./ai/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "heliony": "./bin/heliony.mjs"
  },
  "files": [
    "dist",
    "tokens",
    "ai",
    "bin",
    "templates",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "ai": "node scripts/build-ai.mjs",
    "build": "bun run tokens && svelte-package -i src/lib -o dist && bun run ai && node -e \"require('fs').writeFileSync('dist/.version', require('./package.json').version)\"",
    "prepare": "node scripts/prepare.mjs",
    "check": "bun run tokens && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && node bin/heliony.mjs check src/lib docs/src --self",
    "test": "vitest run",
    "docs:dev": "vite --config docs/vite.config.ts",
    "docs:build": "vite build --config docs/vite.config.ts",
    "verify": "bun run check && bun run test && bun run build && bun run docs:build && node scripts/verify-fixture.mjs"
  },
  "peerDependencies": {
    "svelte": "^5.40.0",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.81.0",
    "@tanstack/table-core": "^8.21.3",
    "bits-ui": "^2.22.0",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "tailwind-merge": "^3.7.1",
    "tailwind-variants": "^4.0.2"
  },
  "devDependencies": {
    "@sveltejs/package": "^3.0.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.11",
    "culori": "^4.0.2",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
